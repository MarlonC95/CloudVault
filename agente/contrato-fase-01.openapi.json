        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "NO_AUTENTICADO",
                  "TOKEN_INVALIDO",
                  "SIN_PERMISO",
                  "NO_ENCONTRADO",
                  "CUOTA_EXCEDIDA",
                  "RATE_LIMITED",
                  "ERROR_INTERNO",
                  "SERVICE_UNAVAILABLE"
                ]
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "code"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
