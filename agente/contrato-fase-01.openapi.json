  "components": {
    "schemas": {
      "IniciarCargaInput": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?!\\s*$)(?!\\s*\\.{1,2}\\s*$)[^/\\\\\\x00-\\x1f\\x7f]+$"
          },
          "tamano_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1073741824,
            "description": "Límite operativo del perfil documentado; la cuota se valida antes de firmar."
          },
          "tipo_mime": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9!#$&^_.+\\-]+/[A-Za-z0-9!#$&^_.+\\-]+(?![\\s\\S])"
          },
          "carpeta_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "nullable": true,
            "default": null
          }
        },
        "additionalProperties": false,
        "required": [
          "nombre",
          "tamano_bytes",
          "tipo_mime"
        ]
      },
      "ConfirmarCargaInput": {
        "type": "object",
        "properties": {
          "etag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "description": "Opcional; se conserva literalmente y no equivale a SHA-256."
          }
        },
        "additionalProperties": false
      },
      "IniciarCargaSuccess": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "archivo_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "url_subida": {
                "type": "string",
                "format": "uri",
                "maxLength": 8192
              },
              "metodo": {
                "type": "string",
                "enum": [
                  "PUT"
                ]
              },
              "encabezados": {
                "type": "object",
                "properties": {
                  "Content-Type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9!#$&^_.+\\-]+/[A-Za-z0-9!#$&^_.+\\-]+(?![\\s\\S])"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "Content-Type"
                ]
              },
              "expira_en": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 en UTC."
              }
            },
            "additionalProperties": false,
            "required": [
              "archivo_id",
              "url_subida",
              "metodo",
              "encabezados",
              "expira_en"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "data"
        ]
      },
      "ConfirmarCargaSuccess": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
