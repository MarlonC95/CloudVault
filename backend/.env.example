# Copia este archivo como backend/.env y rellena los valores (NO subas el .env a Git).

# Seguridad de Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true

# PostgreSQL (Railway). La aplicación usa las tablas de Marlon en el esquema public.
# El usuario necesita SELECT/INSERT/UPDATE/DELETE sobre ellas: ver database/preparar_public.sql.
# Nunca ejecutar `manage.py migrate` contra esta base: los modelos son managed = False.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:PUERTO/railway?options=-csearch_path%3Dpublic

# Bucket S3 (Railway)
AWS_ENDPOINT_URL=https://t3.storageapi.dev
AWS_REGION=auto
AWS_STORAGE_BUCKET_NAME=nombre-del-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend en desarrollo (también debe estar permitido en el CORS del bucket)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
